{
  "entities": {
    "completed_workouts": {
      "title": "Completed Workouts",
      "description": "Logged workout sessions with exercises, weights, and reps",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "startTime": { "type": "number" },
        "endTime": { "type": "number" },
        "exercises": { "type": "array" },
        "notes": { "type": "string" },
        "totalVolume": { "type": "number" }
      },
      "required": ["id", "name", "startTime", "exercises"]
    },
    "workout_templates": {
      "title": "Workout Templates",
      "description": "Pre-configured routines",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "exercises": { "type": "array" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "exercises": {
      "title": "Exercises",
      "description": "Full directory of 800+ fitness movements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "equipment": { "type": "string" },
        "primaryMuscles": { "type": "array" },
        "secondaryMuscles": { "type": "array" },
        "instructions": { "type": "array" },
        "isCustom": { "type": "boolean" }
      },
      "required": ["id", "name", "category"]
    },
    "active_sessions": {
      "title": "Active Sessions",
      "description": "Currently in-progress workout session state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "startTime": { "type": "number" },
        "exercises": { "type": "array" },
        "notes": { "type": "string" }
      },
      "required": ["name", "startTime", "exercises"]
    },
    "breath_patterns": {
      "title": "Breath Patterns",
      "description": "Calibrated phase durations for scientific breathwork protocols",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patternId": { "type": "string" },
        "inhale": { "type": "number" },
        "inhaleHold": { "type": "number" },
        "exhale": { "type": "number" },
        "exhaleHold": { "type": "number" },
        "updatedAt": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "patternId", "inhale", "exhale"]
    },
    "breathwork_sessions": {
      "title": "Breathwork Sessions",
      "description": "Logged breath coach practice sessions with post-session state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "timestamp": { "type": "number" },
        "patternId": { "type": "string" },
        "patternName": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "durationSeconds": { "type": "number" },
        "cyclesCompleted": { "type": "number" },
        "feelingAfter": { "type": "string" },
        "backgroundScene": { "type": "string" },
        "userId": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "patternName", "durationMinutes", "cyclesCompleted"]
    },
    "activity_logs": {
      "title": "Activity Logs",
      "description": "Audit telemetry events for breathwork coaching and workouts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventType": { "type": "string" },
        "patternId": { "type": "string" },
        "timestamp": { "type": "string" },
        "userId": { "type": "string" },
        "details": { "type": "object" }
      },
      "required": ["id", "eventType", "timestamp"]
    }
  },
  "firestore": {
    "completed_workouts/{workoutId}": {
      "schema": { "$ref": "#/entities/completed_workouts" },
      "description": "Collection storing completed workout logs"
    },
    "workout_templates/{templateId}": {
      "schema": { "$ref": "#/entities/workout_templates" },
      "description": "Collection storing saved routines and templates"
    },
    "exercises/{exerciseId}": {
      "schema": { "$ref": "#/entities/exercises" },
      "description": "Collection storing full 800+ exercise movements library"
    },
    "active_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/active_sessions" },
      "description": "Collection storing currently active workout session state"
    },
    "breath_patterns/{patternId}": {
      "schema": { "$ref": "#/entities/breath_patterns" },
      "description": "Calibrated phase seconds for breath protocols"
    },
    "users/{userId}/breathPatterns/{patternId}": {
      "schema": { "$ref": "#/entities/breath_patterns" },
      "description": "User-scoped calibrated breath protocol configurations"
    },
    "breathwork_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/breathwork_sessions" },
      "description": "Collection storing logged breathwork practice sessions"
    },
    "users/{userId}/breathworkSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/breathwork_sessions" },
      "description": "User-scoped logged breathwork practice sessions"
    },
    "activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/activity_logs" },
      "description": "Audit telemetry log collection"
    },
    "users/{userId}/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/activity_logs" },
      "description": "User-scoped audit telemetry logs"
    }
  }
}
